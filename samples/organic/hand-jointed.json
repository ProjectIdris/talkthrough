{
  "steps": [
    {
      "say": "Let's build the hand, part by part.",
      "actions": [
        {"op": "box", "id": "fig", "x": 547, "y": 133, "w": 166, "h": 242, "color": "blue"}
      ]
    },
    {
      "say": "Start with the palm and wrist. The palm is broad across the knuckles and narrows to the wrist, and the forearm runs on from it.",
      "actions": [
        {"op": "panel", "x": 720, "y": 140, "w": 270, "h": 640},
        {"op": "add", "shape": "extrude", "id": "palm", "outline": [[-2.25,2],[-1,2.3],[1,2.3],[2.25,2],[2.2,0.3],[1.75,-1.3],[1.4,-2.4],[1.45,-3.2],[-1.45,-3.2],[-1.4,-2.4],[-1.75,-1.3],[-2.2,0.3]], "depth": 1, "material": "skin"},
        {"op": "add", "shape": "extrude", "id": "forearm", "outline": [[-1.45,-2.6],[1.45,-2.6],[1.7,-4.5],[1.9,-6.2],[-1.9,-6.2],[-1.7,-4.5]], "depth": 1, "material": "skin", "at": 0.4},
        {"op": "pin", "id": "palmtag", "on": "palm", "text": "Palm", "at": 1.2},
        {"op": "pin", "id": "wristtag", "on": "forearm", "text": "Wrist", "at": 1.6, "point": [0,-2.7,0.5]},
        {"op": "pin", "id": "armtag", "on": "forearm", "text": "Forearm", "at": 2}
      ]
    },
    {
      "say": "Now the four fingers. Each starts under a ridge across the knuckles, fans a little apart, and tapers to a rounded tip with a slight swelling at each joint. The middle finger is the longest and the little finger the shortest.",
      "actions": [
        {"op": "add", "shape": "blob", "id": "hypothenar", "pts": [[-1.7,-0.6,0.3]], "sizes": [[1.1,2.4,0.9]], "material": "skin"},
        {"op": "add", "shape": "tube", "id": "ridge", "pts": [[-1.9,1.85,0.1],[-0.6,2.05,0.1],[0.6,2.05,0.1],[1.9,1.85,0.1]], "radius": 0.42, "material": "skin"},
        {"op": "add", "shape": "tube", "id": "index", "pts": [[1.45,1.4,0],[1.6,2.7,0.05],[1.75,4,0.1],[1.85,5,0.08]], "radius": 0.46, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin"},
        {"op": "add", "shape": "tube", "id": "middle", "pts": [[0.5,1.5,0],[0.52,2.9,0.05],[0.55,4.4,0.1],[0.57,5.6,0.08]], "radius": 0.47, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 0.5},
        {"op": "add", "shape": "tube", "id": "ring", "pts": [[-0.5,1.45,0],[-0.62,2.8,0.05],[-0.75,4.1,0.1],[-0.85,5.1,0.08]], "radius": 0.44, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 1},
        {"op": "add", "shape": "tube", "id": "little", "pts": [[-1.45,1.2,0],[-1.7,2.3,0.05],[-1.95,3.3,0.1],[-2.1,4,0.08]], "radius": 0.38, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 1.5},
        {"op": "pin", "id": "indextag", "on": "index", "text": "Index finger", "at": 1.1},
        {"op": "pin", "id": "midtag", "on": "middle", "text": "Middle finger", "at": 1.5},
        {"op": "pin", "id": "ringtag", "on": "ring", "text": "Ring finger", "at": 2},
        {"op": "pin", "id": "littag", "on": "little", "text": "Little finger", "at": 2.5}
      ]
    },
    {
      "say": "Last, the opposable thumb. It leaves the palm low and to the side, shorter and thicker than a finger and with a fleshy ball at its root, so it can swing across to meet the fingers.",
      "actions": [
        {"op": "add", "shape": "blob", "id": "thenar", "pts": [[1.35,-0.9,0.4]], "sizes": [[1.6,2.1,1.1]], "material": "skin"},
        {"op": "add", "shape": "tube", "id": "thumb", "pts": [[1.3,-1.4,0.15],[2.45,-0.65,0.6],[3.3,0.5,0.9]], "radius": 0.58, "swell": [[0,1.25],[0.45,1],[1,0.75]], "material": "skin"},
        {"op": "pin", "id": "thumbtag", "on": "thumb", "text": "Thumb", "at": 0.8},
        {"op": "pin", "id": "knucktag", "on": "palm", "text": "Knuckles", "at": 1.6, "point": [0,2,0.6]}
      ]
    },
    {
      "say": "Each finger has three bones and bends at its knuckles, pulled closed by tendons from muscles in the forearm.",
      "actions": [
        {"op": "highlight", "id": "forearm", "color": "red", "at": 0.5},
        {"op": "highlight", "id": "palm", "color": "red", "at": 1.2}
      ]
    }
  ]
}
