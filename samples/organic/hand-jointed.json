{
  "steps": [
    {
      "say": "Let's build the hand, part by part.",
      "actions": [
        {"op": "box", "id": "fig", "x": 547, "y": 133, "w": 166, "h": 242, "color": "blue"}
      ]
    },
    {
      "say": "Start with the palm and wrist. The broad palm is the base, and the wrist joins it to the forearm.",
      "actions": [
        {"op": "panel", "x": 720, "y": 140, "w": 270, "h": 640},
        {"op": "add", "shape": "box", "id": "palm", "size": [4,4.2,1.1], "bevel": 0.4, "material": "skin"},
        {"op": "add", "shape": "box", "id": "wrist", "size": [3.2,2,0.95], "bevel": 0.3, "pos": [0,-2.9,0], "material": "skin", "at": 0.4},
        {"op": "add", "shape": "box", "id": "forearm", "size": [3.4,2.4,1.1], "bevel": 0.35, "pos": [0,-4.6,0], "material": "skin", "at": 0.8},
        {"op": "pin", "id": "palmtag", "on": "palm", "text": "Palm", "at": 1.2},
        {"op": "pin", "id": "wristtag", "on": "wrist", "text": "Wrist", "at": 1.6},
        {"op": "pin", "id": "armtag", "on": "forearm", "text": "Forearm", "at": 2}
      ]
    },
    {
      "say": "Now the four fingers. Each starts inside the palm and tapers toward its tip.",
      "actions": [
        {"op": "add", "shape": "tube", "id": "index", "pts": [[1.5,1.2,0],[1.55,2.2,0.05],[1.62,3.4,0.1],[1.68,4.4,0.1],[1.72,5.3,0.05]], "radius": 0.42, "swell": [[0,1],[1,0.75]], "material": "skin"},
        {"op": "add", "shape": "tube", "id": "middle", "pts": [[0.5,1.2,0],[0.5,2.2,0.05],[0.5,3.6,0.1],[0.5,4.8,0.1],[0.5,5.8,0.05]], "radius": 0.43, "swell": [[0,1],[1,0.75]], "material": "skin", "at": 0.5},
        {"op": "add", "shape": "tube", "id": "ring", "pts": [[-0.5,1.2,0],[-0.52,2.2,0.05],[-0.56,3.5,0.1],[-0.6,4.5,0.1],[-0.62,5.4,0.05]], "radius": 0.41, "swell": [[0,1],[1,0.75]], "material": "skin", "at": 1},
        {"op": "add", "shape": "tube", "id": "little", "pts": [[-1.5,1,0],[-1.6,2,0.05],[-1.75,3.1,0.1],[-1.85,3.9,0.1],[-1.92,4.6,0.05]], "radius": 0.37, "swell": [[0,1],[1,0.75]], "material": "skin", "at": 1.5},
        {"op": "pin", "id": "indextag", "on": "index", "text": "Index finger", "at": 1.1},
        {"op": "pin", "id": "midtag", "on": "middle", "text": "Middle finger", "at": 1.5},
        {"op": "pin", "id": "ringtag", "on": "ring", "text": "Ring finger", "at": 2},
        {"op": "pin", "id": "littag", "on": "little", "text": "Little finger", "at": 2.5}
      ]
    },
    {
      "say": "Last, the opposable thumb. It leaves the palm low and to the side, so it can swing across to meet the fingers.",
      "actions": [
        {"op": "add", "shape": "tube", "id": "thumb", "pts": [[1.1,-1.3,0],[2.3,-0.8,0.1],[3.1,0.3,0.2],[3.6,1.4,0.2],[3.9,2.3,0.15]], "radius": 0.5, "swell": [[0,1.1],[1,0.75]], "material": "skin"},
        {"op": "pin", "id": "thumbtag", "on": "thumb", "text": "Thumb", "at": 0.8},
        {"op": "pin", "id": "knucktag", "on": "palm", "point": [0,1.9,0.6], "text": "Knuckles", "at": 1.6}
      ]
    },
    {
      "say": "Each finger has three bones and bends at its knuckles, pulled closed by tendons from muscles in the forearm.",
      "actions": [
        {"op": "highlight", "id": "forearm", "color": "red", "at": 0.5},
        {"op": "highlight", "id": "palm", "color": "red", "at": 1.2}
      ]
    }
  ]
}
