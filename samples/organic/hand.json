{
  "escalate": null,
  "steps": [
    {
      "say": "Here is a human hand, so let me build one and name its parts.",
      "actions": [
        {"op": "box", "id": "pic", "x": 555, "y": 135, "w": 150, "h": 170, "color": "blue"}
      ]
    },
    {
      "say": "Start with the palm. It is the broad centre of the hand, wider across the knuckles than at the wrist, and the forearm runs on from it.",
      "actions": [
        {"op": "panel", "x": 710, "y": 330, "w": 280, "h": 660},
        {"op": "add", "shape": "group", "id": "hand"},
        {"op": "add", "shape": "extrude", "id": "palm", "parent": "hand", "outline": [[2.25,2],[1,2.3],[-1,2.3],[-2.25,2],[-2.2,0.3],[-1.75,-1.3],[-1.4,-2.4],[-1.45,-3.2],[1.45,-3.2],[1.4,-2.4],[1.75,-1.3],[2.2,0.3]], "depth": 1, "material": "skin", "at": 0.3},
        {"op": "add", "shape": "extrude", "id": "forearm", "parent": "hand", "outline": [[1.45,-2.6],[-1.45,-2.6],[-1.7,-4.5],[-1.9,-6.2],[1.9,-6.2],[1.7,-4.5]], "depth": 1, "material": "skin", "at": 0.6},
        {"op": "pin", "id": "palmtag", "on": "palm", "text": "Palm", "at": 1},
        {"op": "pin", "id": "wristtag", "on": "forearm", "text": "Wrist", "at": 1.6, "point": [0,-2.7,0.5]}
      ]
    },
    {
      "say": "Now the thumb. It stands apart from the rest, so it can press against the other fingers to grip. Next to it is the index finger.",
      "actions": [
        {"op": "add", "shape": "blob", "id": "thenar", "parent": "hand", "pts": [[-1.35,-0.9,0.4]], "sizes": [[1.6,2.1,1.1]], "material": "skin", "at": 0.3},
        {"op": "add", "shape": "tube", "id": "thumb", "parent": "hand", "pts": [[-1.3,-1.4,0.15],[-2.45,-0.65,0.6],[-3.3,0.5,0.9]], "radius": 0.58, "swell": [[0,1.25],[0.45,1],[1,0.75]], "material": "skin", "at": 0.3},
        {"op": "add", "shape": "tube", "id": "index", "parent": "hand", "pts": [[-1.45,1.4,0],[-1.6,2.7,0.05],[-1.75,4,0.1],[-1.85,5,0.08]], "radius": 0.46, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 0.7},
        {"op": "pin", "id": "thumbtag", "on": "thumb", "text": "Thumb", "at": 1.2},
        {"op": "pin", "id": "indextag", "on": "index", "text": "Index finger", "at": 1.9}
      ]
    },
    {
      "say": "Three more fingers. The middle finger is the longest, then the ring finger, and the little finger is the smallest. A fleshy mound runs down the palm below it.",
      "actions": [
        {"op": "add", "shape": "blob", "id": "hypothenar", "parent": "hand", "pts": [[1.7,-0.6,0.3]], "sizes": [[1.1,2.4,0.9]], "material": "skin"},
        {"op": "add", "shape": "tube", "id": "ridge", "parent": "hand", "pts": [[1.9,1.85,0.1],[0.6,2.05,0.1],[-0.6,2.05,0.1],[-1.9,1.85,0.1]], "radius": 0.42, "material": "skin"},
        {"op": "add", "shape": "tube", "id": "middle", "parent": "hand", "pts": [[-0.5,1.5,0],[-0.52,2.9,0.05],[-0.55,4.4,0.1],[-0.57,5.6,0.08]], "radius": 0.47, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 0.3},
        {"op": "add", "shape": "tube", "id": "ring", "parent": "hand", "pts": [[0.5,1.45,0],[0.62,2.8,0.05],[0.75,4.1,0.1],[0.85,5.1,0.08]], "radius": 0.44, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 0.9},
        {"op": "add", "shape": "tube", "id": "little", "parent": "hand", "pts": [[1.45,1.2,0],[1.7,2.3,0.05],[1.95,3.3,0.1],[2.1,4,0.08]], "radius": 0.38, "swell": [[0,1.12],[0.3,1],[0.33,1.05],[0.36,0.96],[0.62,0.92],[0.65,0.97],[0.68,0.9],[1,0.7]], "material": "skin", "at": 1.5},
        {"op": "pin", "id": "middletag", "on": "middle", "text": "Middle finger", "at": 0.8},
        {"op": "pin", "id": "ringtag", "on": "ring", "text": "Ring finger", "at": 1.4},
        {"op": "pin", "id": "littletag", "on": "little", "text": "Little finger", "at": 2}
      ]
    }
  ]
}
