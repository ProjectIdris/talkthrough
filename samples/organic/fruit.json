      "actions": [
        {"op": "panel", "x": 715, "y": 335, "w": 270, "h": 620},
        {"op": "add", "shape": "group", "id": "peach"},
        {"op": "add", "shape": "shell", "id": "skin", "parent": "peach", "size": [5, 4.8, 5], "inner": 0.97, "material": "skin", "color": "orange", "roughness": 0.9, "at": 0.3},
        {"op": "add", "shape": "lathe", "id": "flesh", "parent": "peach", "profile": [[0, -2.25], [0.61, -2.17], [1.175, -1.95], [1.66, -1.59], [2.035, -1.125], [2.27, -0.58], [2.35, 0], [2.27, 0.58], [2.035, 1.125], [1.66, 1.59], [1.175, 1.95], [0.61, 2.17], [0, 2.25]], "material": "cheese", "color": "yellow", "at": 0.3}
      ]
    },
    {
      "say": "Now slice it in half. The cut runs straight through the middle, past the stone.",
