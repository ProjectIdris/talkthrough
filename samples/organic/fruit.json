{
  "escalate": null,
  "steps": [
    {
      "say": "Juicy flesh around a hard stone. Let me cut one open for you.",
      "actions": [
        {"op": "box", "id": "pic", "x": 560, "y": 140, "w": 140, "h": 160, "color": "orange"}
      ]
    },
    {
