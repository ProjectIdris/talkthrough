        {"op": "pin", "id": "skintag", "on": "skin", "point": [2.45, -0.4, 0], "text": "Skin", "at": 1.5}
      ]
    },
    {
      "say": "At the heart sits the stone. It is hard and woody, and inside it is the seed, called the kernel.",
      "actions": [
        {"op": "pin", "id": "stonetag", "on": "stone", "point": [0.6, 0.3, 0], "text": "Stone", "at": 0.5},
        {"op": "pin", "id": "seedtag", "on": "kernel", "text": "Seed", "at": 1.8}
      ]
