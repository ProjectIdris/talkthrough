        { "op": "pin", "id": "ribbon-label", "on": "ribbon", "text": "Flattened section" },
        { "op": "pin", "id": "grip-label", "on": "grip", "text": "Curved section" },
        { "op": "orbit", "az": -24, "el": 12, "dur": 2 }
      ]
    }
  ]
