{
  "name": "talkthrough",
  "version": "0.3.5",
  "description": "An AI that talks you through anything on your screen, and draws as it talks.",
  "keywords": [
    "screen assistant",
    "overlay",
    "ai",
    "three.js",
    "electron"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "get-windows": "10.0.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "three": "0.187.0",
    "typescript": "7.0.2"
  },
  "author": "Talkthrough contributors"
}
